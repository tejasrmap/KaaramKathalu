rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // settings: anyone can read, authenticated users can write
    match /settings/{setting} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // products: anyone can read, authenticated users can write/update stock counts
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // orders: anyone can read (for guest tracking), authenticated users can create, serverless callbacks can update
    match /orders/{order} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
    }
    
    // users: users can read and write their own profile records
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // admins: anyone authenticated can read (needed for login check),
    // but only existing admins can add/remove other admins
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
  }
}
