rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // settings: anyone can read, authenticated users can write
    match /settings/{setting} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // products: anyone can read, authenticated users can write/update stock counts
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // orders: authenticated users can create and read orders
    match /orders/{order} {
      allow read, write: if request.auth != null;
    }
    
    // users: users can read and write their own profile records
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
